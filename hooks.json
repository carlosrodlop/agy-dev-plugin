{
  "agy-dev-sdlc-guardrail": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "python3 $HOME/.gemini/config/plugins/agy-dev-plugin/clients/dev_common.py guardrail-hook --event PreToolUse",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "run_command|write_file|edit_file|replace_file_content|multi_replace_file_content"
      }
    ],
    "SessionStart": [
      {
        "command": "python3 $HOME/.gemini/config/plugins/agy-dev-plugin/clients/dev_common.py guardrail-hook --event SessionStart",
        "timeout": 5,
        "type": "command"
      }
    ],
    "enabled": true
  }
}
