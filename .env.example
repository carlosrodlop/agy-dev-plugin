# ==============================================================================
# Environment Variables Template (.env.example)
# Safe mock placeholder template for ~/.env (zero real secrets or PII).
# Copy to ~/.env (chmod 600 ~/.env) and replace placeholders with real values.
# ==============================================================================

# 1. Antigravity Dev & SDLC Plugin State Directory
AGY_DEV_STATE_DIR="~/.local/share/agy-dev-plugin"
AGY_CONF_REPO_DIR="<your-agy-conf-repo-dir-here>"

# 2. Optional Companion Bridge Settings (only used if installed on workstation)
# WIZ_CUSTOMER_PORTFOLIO_DIR="~/.local/share/wiz-customer-portfolio"
# AGY_DEV_NOTIFY_CMD=""
# NOTIFICATION_EMAIL_ERRORS_ONLY="true"

# 3. Model Routing, Cross-Family Quota Balancing, Low-Quota Eco & Automatic Fallback (Optional)
